  inputsRedactedJson   Json     @map("inputs_redacted_json")
  rowCountTotal        Int      @map("row_count_total")
  durationMs           Int      @map("duration_ms")
  servedByNode         String   @map("served_by_node") @db.VarChar(64)
  verificationSha256   String   @map("verification_sha256") @db.VarChar(64)
  renderTarget         String   @default("CLIENT_PAGED_VECTOR") @map("render_target") @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([merchantId, createdAt(sort: Desc)], map: "merchant_report_execution_audit_merchant_created_idx")
  @@index([merchantSpecId, createdAt(sort: Desc)], map: "merchant_report_execution_audit_spec_created_idx")
  @@map("merchant_report_execution_audit")
}

model MerchantReportRateEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  action     String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([merchantId, action, createdAt(sort: Desc)], map: "merchant_report_rate_events_merchant_action_created_idx")
  @@map("merchant_report_rate_events")
}

model MerchantReportStudioStatus {
  merchantId         String    @id @map("merchant_id") @db.Uuid
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedByUserId  String?   @map("suspended_by_user_id") @db.Uuid
  reason             String?   @db.Text
