model GlAccount {
  id              String        @id @default(uuid(7)) @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  accountType     GlAccountType @map("account_type")
  ownerId         String?       @map("owner_id")
  gatewayId       String?       @map("gateway_id") @db.Uuid
  credentialSetId String?       @map("credential_set_id") @db.Uuid
  env             String?
  currency        String        @db.Char(3)
  /// Routing width: new lines go to shard `hash(refId) % shardCount` (wallet debits always to shard 0).
  /// Widening never remaps history because every journal line stores its own shard.
  shardCount      Int           @default(1) @map("shard_count") @db.SmallInt
  shardScaledAt   DateTime?     @map("shard_scaled_at") @db.Timestamptz(3)
  seedKey         String?       @unique @map("seed_key")

  wallet        Wallet?          @relation("WalletGlAccount")
  gateway       Gateway?         @relation("GatewayClearingAccounts", fields: [gatewayId], references: [id], onDelete: Restrict)
  credentialSet CredentialSet?   @relation("CredentialSetGlAccounts", fields: [credentialSetId], references: [id], onDelete: Restrict)
  journalLines  JournalLine[]
  adjustments   Adjustment[]     @relation("AdjustmentTargetAccount")
  shards        GlAccountShard[]

  @@unique([gatewayId, env, credentialSetId])
  @@index([accountType])
  @@index([ownerId])
  @@index([gatewayId])
  @@map("gl_accounts")
}

model JournalEntry {
  id          String         @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  refType     JournalRefType @map("ref_type")
  refId       String         @map("ref_id")
  description String         @db.Text

  journalLines    JournalLine[]
  adjustments     Adjustment[]     @relation("AdjustmentJournalEntry")
  amlCases        AmlCase[]        @relation("AmlCaseHoldEntry")
  paymentAttempts PaymentAttempt[] @relation("PaymentAttemptLedgerEntry")

  @@unique([refType, refId])
  // Admin list/summary queries order and filter by createdAt. The migration adds
  // INCLUDE (id, ref_type, ref_id) and a pg_trgm GIN index on ref_id/description.
  @@index([createdAt])
  @@map("journal_entries")
}

model JournalLine {
  id          String           @default(uuid(7)) @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  entryId     String           @map("entry_id") @db.Uuid
  glAccountId String           @map("gl_account_id") @db.Uuid
  direction   JournalDirection
  amount      Decimal          @db.Decimal(18, 4)
  /// The shard this line was posted to, and its position in that shard's gapless sequence.
  /// shard_seq 0 = pre-genesis (folded into the genesis checkpoint); real lines are >= 1.
  shardId     Int              @map("shard_id") @db.SmallInt
  shardSeq    BigInt           @map("shard_seq")

  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  glAccount GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  // journal_lines is monthly range-partitioned by created_at in PostgreSQL 18.
  // The partition key must participate in the primary key.
  @@id([id, createdAt])
  @@index([entryId, createdAt])
  @@index([glAccountId, createdAt])
  @@index([glAccountId, shardId, shardSeq])
  @@map("journal_lines")
}

