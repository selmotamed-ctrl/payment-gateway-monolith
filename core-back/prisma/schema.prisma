/// Why a gateway status-inquiry schedule was created.
enum GatewayInquiryScheduleSource {
  OPERATOR_CASE
  AUTOMATIC
}

/// The lifecycle of one persisted gateway status-inquiry schedule.
enum GatewayInquiryScheduleStatus {
  /// Waiting for its `next_run_at` timer.
  SCHEDULED
  /// The poll worker is currently asking the gateway.
  RUNNING
  /// The inquiry returned a non-terminal result or a transient error and will run again.
  RETRYING
  /// The attempt reached a terminal state or the inquiry finished.
  COMPLETED
  /// The inquiry ended with a technical failure and will not run again.
  FAILED
  /// An operator cancelled the schedule before it could run.
  CANCELLED
  /// The route polling window elapsed before a definitive result was reached.
  EXPIRED
}

/// The kind of work a durable background job carries.
enum BackgroundJobType {
  /// Parses and matches an uploaded statement file against the local attempts.
  RECONCILIATION_RUN
  /// Executes a dispute intake or an approved adjustment (the ledger posting,
  /// the state change and the audit trail in one transaction).
  ADJUSTMENT_EXECUTION
  /// Asks the gateway again about a refund stuck in EXECUTING, with backoff (AUTO-20).
  REFUND_INQUIRY
}

/// The lifecycle of a durable background job.
enum BackgroundJobState {
  /// Waiting for its `available_at` timer.
  QUEUED
  /// Claimed by a worker node and currently executing.
  RUNNING
  /// Finished successfully.
  SUCCEEDED
  /// Exhausted its attempts and will never run again.
  FAILED
}

