model Merchant {
  id                          String         @id @default(uuid(7))
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  legalName                   String
  tradeName                   String
  taxId                       String?
  registrationNo              String?
  businessCategory            String?
  status                      MerchantStatus @default(PENDING)
  kybStatus                   KybStatus      @default(UNVERIFIED)
  riskTier                    RiskTier       @default(STANDARD)
  onboardingChannel           String
  country                     String         @db.Char(2)
  contactPhone                String?
  contactEmail                String?
  activatedAt                 DateTime?
  suspendedAt                 DateTime?
  suspensionReasonCode        String?
  closedAt                    DateTime?
  commissionReceivableCeiling Decimal?       @db.Decimal(18, 4)
  negativeBalanceCeiling      Decimal        @default(0) @db.Decimal(18, 4)
  payoutBankDetailsJson       Json?

  users              User[]              @relation("MerchantUsers")
  applications       Application[]
  wallets            Wallet[]
  accessTokens       AccessToken[]
  commissionProfiles CommissionProfile[] @relation("MerchantCommissionProfiles")
  credentialSets     CredentialSet[]     @relation("MerchantCredentialSets")
  cashoutRequests    CashoutRequest[]
  paymentAttempts    PaymentAttempt[]    @relation("MerchantPaymentAttempts")
  detailChangeLogs   DetailChangeLog[]   @relation("MerchantDetailChangeLogs")
  joinRequests       JoinRequest[]
  kybDocuments       KybDocument[]
  beneficialOwners   BeneficialOwner[]
  notifications      Notification[]      @relation("MerchantNotifications")

  @@index([status])
  @@index([kybStatus])
  @@map("merchants")
}

model User {
  id                  String     @id @default(uuid(7))
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  merchantId          String?    @map("merchant_id")
  email               String     @unique
  phone               String?
  passwordHash        String?    @map("password_hash")
  role                UserRole
  authoritiesMap      Json       @map("authorities_map")
  appScopeIds         Json?      @map("app_scope_ids")
  isMaker             Boolean    @default(false) @map("is_maker")
  isChecker           Boolean    @default(false) @map("is_checker")
  mfaRequired         Boolean    @default(true) @map("mfa_required")
  mfaSecretCiphertext String?    @map("mfa_secret_ciphertext")
  status              UserStatus @default(INVITED)

  merchant                 Merchant?           @relation("MerchantUsers", fields: [merchantId], references: [id], onDelete: SetNull)
  identities               UserIdentity[]
  createdGatewayVersions   GatewayVersion[]    @relation("GatewayVersionCreatedBy")
  makerApprovalRequests    ApprovalRequest[]   @relation("ApprovalMaker")
  checkerApprovalRequests  ApprovalRequest[]   @relation("ApprovalChecker")
  amlCases                 AmlCase[]           @relation("AmlCaseReviewer")
  amlScreeningDispositions AmlScreeningMatch[] @relation("AmlScreeningDispositionBy")
  submittedJoinRequests    JoinRequest[]       @relation("JoinRequestSubmitter")
  assignedJoinRequests     JoinRequest[]       @relation("JoinRequestReviewer")
  reviewedKybDocuments     KybDocument[]       @relation("KybDocumentReviewer")
  assignedOperatorCases    OperatorCase[]      @relation("OperatorCaseAssignee")
  detailChangeLogs         DetailChangeLog[]   @relation("DetailChangeLogActor")
  auditLogs                AuditLog[]          @relation("AuditLogActor")
  notifications            Notification[]      @relation("NotificationRecipient")

  @@index([merchantId])
  @@index([role])
  @@map("users")
}

model Application {
  id                      String            @id @default(uuid(7))
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  merchantId              String            @map("merchant_id")
  name                    String
  businessUseDescription  String?
  expectedMonthlyVolume   Decimal           @default(0) @db.Decimal(18, 4)
  assignedWalletId        String            @map("assigned_wallet_id")
  railWhitelist           Json?             @map("rail_whitelist")
  redirectDomainAllowlist Json?             @map("redirect_domain_allowlist")
  status                  ApplicationStatus @default(PENDING)

  merchant           Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  assignedWallet     Wallet              @relation("ApplicationWallet", fields: [assignedWalletId], references: [id], onDelete: Restrict)
  posTerminals       PosTerminal[]
  accessTokens       AccessToken[]
  paymentLinks       PaymentLink[]
  commissionProfiles CommissionProfile[] @relation("ApplicationCommissionProfiles")
  paymentAttempts    PaymentAttempt[]    @relation("ApplicationPaymentAttempts")

  @@index([merchantId])
  @@index([assignedWalletId])
  @@map("applications")
}

model Wallet {
  id          String       @id @default(uuid(7))
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  merchantId  String       @map("merchant_id")
  glAccountId String       @unique @map("gl_account_id")
  currency    String       @default("LYD") @db.Char(3)
  status      WalletStatus @default(PENDING)

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  glAccount       GlAccount        @relation("WalletGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  applications    Application[]    @relation("ApplicationWallet")
  paymentLinks    PaymentLink[]
  cashoutRequests CashoutRequest[]

  @@index([merchantId])
  @@map("wallets")
}

model AccessToken {
  id                 String    @id @default(uuid(7))
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  merchantId         String    @map("merchant_id")
  applicationId      String    @map("application_id")
  name               String
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  lastFour           String    @map("last_four") @db.Char(4)
  scopes             Json
  ipWhitelistEnabled Boolean   @default(false) @map("ip_whitelist_enabled")
  revokedAt          DateTime? @map("revoked_at")
  lastUsedAt         DateTime? @map("last_used_at")

  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  application Application     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  ips         AccessTokenIp[]

  @@index([merchantId])
  @@index([applicationId])
  @@map("access_tokens")
}

model AccessTokenIp {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tokenId   String   @map("token_id")
  cidr      String

  token AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, cidr])
  @@map("access_token_ips")
}

model PaymentLink {
  id                String           @id @default(uuid(7))
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  key               String           @unique
  applicationId     String           @map("application_id")
  walletId          String           @map("wallet_id")
  amount            Decimal          @db.Decimal(18, 4)
  currency          String           @db.Char(3)
  feeBearer         FeeBearer        @map("fee_bearer")
  splitRatioJson    Json?            @map("split_ratio_json")
  infiniteUse       Boolean          @default(false) @map("infinite_use")
  useCount          Int              @default(1) @map("use_count")
  confirmedCount    Int              @default(0) @map("confirmed_count")
  activeLockedCount Int              @default(0) @map("active_locked_count")
  redirectUrl       String?          @map("redirect_url")
  railWhitelist     Json?            @map("rail_whitelist")
  state             PaymentLinkState @default(PENDING)
  expiresAt         DateTime?        @map("expires_at")

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  attemptGroups   AttemptGroup[]
  paymentAttempts PaymentAttempt[]

  @@index([applicationId])
  @@index([walletId])
  @@index([state])
  @@map("payment_links")
}

model PosTerminal {
  id            String    @id @default(uuid(7))
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  applicationId String    @map("application_id")
  name          String
  location      String?
  status        PosStatus @default(ACTIVE)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  screens     PosScreen[]

  @@index([applicationId])
  @@map("pos_terminals")
}

model PosScreen {
  id             String    @id @default(uuid(7))
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  posId          String    @map("pos_id")
  screenCode     String    @unique @map("screen_code")
  authTokenHash  String    @map("auth_token_hash") @db.Char(64)
  realtimeRoomId String?   @map("realtime_room_id")
  lastActiveAt   DateTime? @map("last_active_at")

  pos PosTerminal @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([posId])
  @@map("pos_screens")
}

model GlAccount {
  id                String        @id @default(uuid(7))
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  accountType       GlAccountType @map("account_type")
  ownerId           String?       @map("owner_id")
  gatewayId         String?       @map("gateway_id")
  credentialSetId   String?       @map("credential_set_id")
  env               String?
  currency          String        @db.Char(3)
  lastCheckpointId  String?       @map("last_checkpoint_id")
  checkpointBalance Decimal       @default(0) @map("checkpoint_balance") @db.Decimal(18, 4)
  checkpointAt      DateTime?     @map("checkpoint_at")
  seedKey           String?       @unique @map("seed_key")

  wallet        Wallet?        @relation("WalletGlAccount")
  gateway       Gateway?       @relation("GatewayClearingAccounts", fields: [gatewayId], references: [id], onDelete: Restrict)
  credentialSet CredentialSet? @relation("CredentialSetGlAccounts", fields: [credentialSetId], references: [id], onDelete: Restrict)
  journalLines  JournalLine[]
  adjustments   Adjustment[]   @relation("AdjustmentTargetAccount")

  @@unique([gatewayId, env, credentialSetId])
  @@index([accountType])
  @@index([ownerId])
  @@index([gatewayId])
  @@map("gl_accounts")
}

model JournalEntry {
  id          String         @id @default(uuid(7))
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  refType     JournalRefType @map("ref_type")
  refId       String         @map("ref_id")
  description String

  journalLines    JournalLine[]
  adjustments     Adjustment[]     @relation("AdjustmentJournalEntry")
  amlCases        AmlCase[]        @relation("AmlCaseHoldEntry")
  paymentAttempts PaymentAttempt[] @relation("PaymentAttemptLedgerEntry")

  @@unique([refType, refId])
  @@map("journal_entries")
}

model JournalLine {
  id          String           @id @default(uuid(7))
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  entryId     String           @map("entry_id")
  glAccountId String           @map("gl_account_id")
  direction   JournalDirection
  amount      Decimal          @db.Decimal(18, 4)

  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  glAccount GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([glAccountId])
  @@map("journal_lines")
}

model CommissionProfile {
  id                String             @id @default(uuid(7))
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  merchantId        String?            @map("merchant_id")
  applicationId     String?            @map("application_id")
  railCode          String             @map("rail_code")
  calcType          CommissionCalcType @map("calc_type")
  flatFee           Decimal            @default(0) @map("flat_fee") @db.Decimal(18, 4)
  percentageRate    Decimal            @default(0) @map("percentage_rate") @db.Decimal(8, 6)
  tiersJson         Json?              @map("tiers_json")
