  effectiveFrom     DateTime        @map("effective_from")
  effectiveTo       DateTime?       @map("effective_to")
  approvalRequestId String?         @map("approval_request_id")

  approvalRequest ApprovalRequest? @relation("AmlRuleApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  amlCases        AmlCase[]        @relation("AmlCaseRule")

  @@index([active])
  @@map("aml_rules")
}

model ReportingRule {
  id                String              @id @default(uuid(7))
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  authority         String              @default("CBL")
  reportType        ReportingType       @map("report_type")
  thresholdAmount   Decimal?            @map("threshold_amount") @db.Decimal(18, 4)
  windowSeconds     Int?                @map("window_seconds")
  currency          String              @default("LYD") @db.Char(3)
  conditions        Json
  sourceReference   String?             @map("source_reference")
  status            ReportingRuleStatus @default(PROVISIONAL)
  effectiveFrom     DateTime            @map("effective_from")
  effectiveTo       DateTime?           @map("effective_to")
  approvalRequestId String?             @map("approval_request_id")

  approvalRequest ApprovalRequest? @relation("ReportingRuleApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reporting_rules")
}

model RegulatoryReport {
  id                String                 @id @default(uuid(7))
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  reportType        ReportingType          @map("report_type")
  authority         String
  subjectType       String                 @map("subject_type")
  subjectId         String                 @map("subject_id")
  amlCaseId         String?                @unique @map("aml_case_id")
  periodStart       DateTime?              @map("period_start")
  periodEnd         DateTime?              @map("period_end")
  status            RegulatoryReportStatus @default(DRAFT)
  payloadCiphertext String                 @map("payload_ciphertext")
  payloadSha256     String                 @map("payload_sha256") @db.Char(64)
  submissionRef     String?                @map("submission_ref")
  submittedAt       DateTime?              @map("submitted_at")
  confidential      Boolean                @default(true)
  approvalRequestId String?                @map("approval_request_id")

  amlCase         AmlCase?         @relation("RegulatoryReportAmlCase", fields: [amlCaseId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation("RegulatoryReportApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("regulatory_reports")
}

model Dispute {
  id                 String        @id @default(uuid(7))
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  attemptId          String        @map("attempt_id")
  gatewayId          String        @map("gateway_id")
  railId             String        @map("rail_id")
  externalDisputeRef String        @map("external_dispute_ref")
  source             DisputeSource
  reasonCode         String?       @map("reason_code")
  amount             Decimal       @db.Decimal(18, 4)
  currency           String        @db.Char(3)
  status             DisputeStatus @default(OPENED)
  openedAt           DateTime      @map("opened_at")
  evidenceDueAt      DateTime?     @map("evidence_due_at")
  outcomeAt          DateTime?     @map("outcome_at")
  adjustmentId       String?       @map("adjustment_id")
  evidenceJson       Json?         @map("evidence_json")

  attempt    PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  gateway    Gateway        @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  rail       Rail           @relation(fields: [railId], references: [id], onDelete: Restrict)
  adjustment Adjustment?    @relation("AdjustmentDispute")

  @@unique([gatewayId, externalDisputeRef])
  @@index([attemptId])
  @@map("disputes")
}

model NotificationTemplate {
  id                   String               @id @default(uuid(7))
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  code                 String
  channel              NotificationChannel
  lang                 NotificationLang
  subjectTemplate      String?              @map("subject_template")
  bodyTemplate         String               @map("body_template")
  confidentialityClass ConfidentialityClass @map("confidentiality_class")
  version              Int                  @default(1)
  active               Boolean              @default(true)

  @@unique([code, channel, lang, version])
  @@index([code])
  @@map("notification_templates")
}

model Notification {
  id                  String              @id @default(uuid(7))
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  eventId             String              @unique @map("event_id")
  recipientUserId     String?             @map("recipient_user_id")
  recipientMerchantId String?             @map("recipient_merchant_id")
  addressMasked       String              @map("address_masked")
  addressCiphertext   String              @map("address_ciphertext")
  templateCode        String              @map("template_code")
  channel             NotificationChannel
  lang                NotificationLang
  payloadJson         Json                @map("payload_json")
  status              NotificationStatus  @default(QUEUED)
  providerMessageId   String?             @map("provider_message_id")
  attempts            Int                 @default(0)
  nextAttemptAt       DateTime?           @map("next_attempt_at")

  recipientUser     User?     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientMerchant Merchant? @relation("MerchantNotifications", fields: [recipientMerchantId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@map("notifications")
}

model PlatformSetting {
  id                String               @id @default(uuid(7))
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  key               String
  scope             PlatformSettingScope @default(PLATFORM)
  valueJson         Json                 @map("value_json")
  version           Int                  @default(1)
  effectiveFrom     DateTime             @map("effective_from")
  approvalRequestId String?              @map("approval_request_id")

  approvalRequest ApprovalRequest? @relation("PlatformSettingApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@unique([key, scope, version])
  @@index([key, scope])
  @@map("platform_settings")
}
