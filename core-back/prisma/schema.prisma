  gatewayVersion      GatewayVersion           @relation(fields: [gatewayVersionId], references: [id], onDelete: Restrict)
  commissionProfile   CommissionProfile        @relation(fields: [commissionProfileId], references: [id], onDelete: Restrict)
  ledgerEntry         JournalEntry?            @relation("PaymentAttemptLedgerEntry", fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  stepLogs            AttemptStepLog[]
  adjustments         Adjustment[]             @relation("AdjustmentSourceAttempt")
  disputes            Dispute[]
  operatorCases       OperatorCase[]
  inquirySchedules    GatewayInquirySchedule[]
  inboundEvents       InboundEvent[]
  reconciliationItems ReconciliationItem[]

  @@unique([linkId, idempotencyKey])
  // Link attempt history is listed newest first; this also serves every
  // plain linkId lookup, so the old single-column linkId index was dropped.
  @@index([linkId, createdAt])
  // merchantId lookups are served by [merchantId, createdAt]; the
  // single-column merchantId index was a redundant prefix and was dropped.
  @@index([status, nextCheckAt])
  @@index([gatewayVersionId])
  // The daily volume aggregate of the rail resolution groups the succeeded
  // attempts by route, so the pair is indexed.
  @@index([routeId, status])
  @@index([merchantId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([status, createdAt])
  @@index([railId, createdAt])
  @@index([applicationId, createdAt])
  @@map("payment_attempts")
}

