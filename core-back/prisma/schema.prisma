model Merchant {
  id                          String         @id @default(uuid(7)) @db.Uuid
  version                     Int            @default(1)
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  legalName                   String         @map("legal_name") @db.Text
  tradeName                   String         @map("trade_name") @db.Text
  displayName                 String?        @map("display_name") @db.Text
  logoUrl                     String?        @map("logo_url") @db.Text
  supportEmail                String?        @map("support_email")
  supportPhone                String?        @map("support_phone")
  taxId                       String?        @map("tax_id") @db.Text
  registrationNo              String?        @map("registration_no") @db.Text
  businessCategory            String?        @map("business_category") @db.Text
  status                      MerchantStatus @default(PENDING)
  kybStatus                   KybStatus      @default(UNVERIFIED) @map("kyb_status")
  riskTier                    RiskTier       @default(STANDARD) @map("risk_tier")
  onboardingChannel           String         @map("onboarding_channel")
  country                     String         @db.Char(2)
  contactPhone                String?        @map("contact_phone")
  contactEmail                String?        @map("contact_email")
  activatedAt                 DateTime?      @map("activated_at")
  suspendedAt                 DateTime?      @map("suspended_at")
  suspensionReasonCode        String?        @map("suspension_reason_code")
  suspensionNotes             String?        @map("suspension_notes") @db.Text
  closedAt                    DateTime?      @map("closed_at")
  closedReasonCode            String?        @map("closed_reason_code") @db.Text
  closedNotes                 String?        @map("closed_notes") @db.Text
  commissionReceivableCeiling Decimal?       @map("commission_receivable_ceiling") @db.Decimal(18, 4)
  negativeBalanceCeiling      Decimal        @default(0) @map("negative_balance_ceiling") @db.Decimal(18, 4)
  payoutBankDetailsJson       Json?          @map("payout_bank_details_json")
  payoutAccountHash           String?        @map("payout_account_hash") @db.Char(64)
  nextKybReviewAt             DateTime?      @map("next_kyb_review_at")

  users                   User[]                   @relation("MerchantUsers")
  applications            Application[]
  wallets                 Wallet[]
  accessTokens            AccessToken[]
  commissionProfiles      CommissionProfile[]      @relation("MerchantCommissionProfiles")
  credentialSets          CredentialSet[]          @relation("MerchantCredentialSets")
  cashoutRequests         CashoutRequest[]
  paymentAttempts         PaymentAttempt[]         @relation("MerchantPaymentAttempts")
  detailChangeLogs        DetailChangeLog[]        @relation("MerchantDetailChangeLogs")
  joinRequests            JoinRequest[]
  kybDocuments            KybDocument[]
  kybRevalidationRequests KybRevalidationRequest[]
  beneficialOwners        BeneficialOwner[]
  notifications           Notification[]           @relation("MerchantNotifications")

  webhookEndpoints  MerchantWebhookEndpoint[]
  webhookDeliveries MerchantWebhookDelivery[]

  @@index([status])
  @@index([kybStatus])
  @@index([status, createdAt])
  @@index([riskTier])
  @@index([kybStatus, status])
  @@index([taxId])
  @@index([registrationNo])
  @@index([contactPhone])
  @@index([contactEmail])
  @@index([payoutAccountHash])
  @@index([nextKybReviewAt])
  @@map("merchants")
}

model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  merchantId          String?    @map("merchant_id") @db.Uuid
  email               String     @unique
  phone               String?
  passwordHash        String?    @map("password_hash") @db.Text
  role                UserRole
  authoritiesMap      Json       @map("authorities_map")
  appScopeIds         Json?      @map("app_scope_ids")
  isMaker             Boolean    @default(false) @map("is_maker")
  isChecker           Boolean    @default(false) @map("is_checker")
  mfaRequired         Boolean    @default(true) @map("mfa_required")
  mfaSecretCiphertext String?    @map("mfa_secret_ciphertext") @db.Text
  invitationTokenHash String?    @map("invitation_token_hash") @db.Char(64)
  invitationExpiresAt DateTime?  @map("invitation_expires_at")
  invitedById         String?    @map("invited_by") @db.Uuid
  status              UserStatus @default(INVITED)
  /**
   * The Employee Academy progress of this user: completed module ids, quiz
   * scores, completed sandbox labs and the earned role badges. Administered by
   * `GET/PUT /internal/admin/academy/progress`.
   */
  academyProgressJson Json?      @map("academy_progress_json")

  merchant                  Merchant?                @relation("MerchantUsers", fields: [merchantId], references: [id], onDelete: SetNull)
  identities                UserIdentity[]
  createdGatewayVersions    GatewayVersion[]         @relation("GatewayVersionCreatedBy")
  makerApprovalRequests     ApprovalRequest[]        @relation("ApprovalMaker")
  checkerApprovalRequests   ApprovalRequest[]        @relation("ApprovalChecker")
  amlCases                  AmlCase[]                @relation("AmlCaseReviewer")
  amlScreeningDispositions  AmlScreeningMatch[]      @relation("AmlScreeningDispositionBy")
  submittedJoinRequests     JoinRequest[]            @relation("JoinRequestSubmitter")
  assignedJoinRequests      JoinRequest[]            @relation("JoinRequestReviewer")
  reviewedKybDocuments      KybDocument[]            @relation("KybDocumentReviewer")
  uploadedKybDocuments      KybDocument[]            @relation("KybDocumentUploader")
  kybRevalidationRequests   KybRevalidationRequest[] @relation("KybRevalidationRequester")
  invitedUsers              User[]                   @relation("UserInvitedBy")
  invitedBy                 User?                    @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  assignedOperatorCases     OperatorCase[]           @relation("OperatorCaseAssignee")
  scheduledGatewayInquiries GatewayInquirySchedule[] @relation("GatewayInquiryScheduledBy")
  cancelledGatewayInquiries GatewayInquirySchedule[] @relation("GatewayInquiryCancelledBy")
  detailChangeLogs          DetailChangeLog[]        @relation("DetailChangeLogActor")
  auditLogs                 AuditLog[]               @relation("AuditLogActor")
  notifications             Notification[]           @relation("NotificationRecipient")
  mfaChallenges             MfaChallenge[]

  @@index([merchantId])
  @@index([role])
  @@index([merchantId, status])
  @@map("users")
}

/// A server-side, single-use MFA challenge. The client only ever holds the
/// opaque `id`; the code is stored as an HMAC (never in plaintext), every wrong
/// guess increments `attempts`, and the challenge dies at `maxAttempts`,
/// on first success (`consumedAt`) or at `expiresAt`. `channel` binds it to
/// the router (ADMIN or MERCHANT) that issued it after a completed password step.
model MfaChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  userId      String    @map("user_id") @db.Uuid
  channel     String    @db.Text
  codeHash    String    @map("code_hash") @db.Char(64)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at")
  lockedAt    DateTime? @map("locked_at")
  expiresAt   DateTime  @map("expires_at")
  ip          String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model Application {
  id                      String            @id @default(uuid(7)) @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  merchantId              String            @map("merchant_id") @db.Uuid
  name                    String
  businessUseDescription  String?           @map("business_use_description") @db.Text
  expectedMonthlyVolume   Decimal           @default(0) @map("expected_monthly_volume") @db.Decimal(18, 4)
  assignedWalletId        String            @map("assigned_wallet_id") @db.Uuid
  railWhitelist           Json?             @map("rail_whitelist")
  redirectDomainAllowlist Json?             @map("redirect_domain_allowlist")
  status                  ApplicationStatus @default(PENDING)

  merchant           Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  assignedWallet     Wallet                    @relation("ApplicationWallet", fields: [assignedWalletId], references: [id], onDelete: Restrict)
  posTerminals       PosTerminal[]
  webhookEndpoints   MerchantWebhookEndpoint[]
  accessTokens       AccessToken[]
  paymentLinks       PaymentLink[]
  commissionProfiles CommissionProfile[]       @relation("ApplicationCommissionProfiles")
  paymentAttempts    PaymentAttempt[]          @relation("ApplicationPaymentAttempts")

  @@index([merchantId])
  @@index([assignedWalletId])
  @@index([merchantId, status])
  @@map("applications")
}

/// AUTO-34: a merchant's webhook endpoint (one application can have several). The signing secret is vault-encrypted.
model MerchantWebhookEndpoint {
  id                       String    @id @default(uuid(7)) @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  merchantId               String    @map("merchant_id") @db.Uuid
  applicationId            String    @map("application_id") @db.Uuid
  url                      String
  description              String?
  /// JSON array of event type names; empty = every event type.
  eventTypes               Json      @default("[]") @map("event_types")
  /// ACTIVE | DISABLED (CHECK constraint).
  status                   String    @default("ACTIVE")
  disabledReason           String?   @map("disabled_reason")
  disabledAt               DateTime? @map("disabled_at")
  secretCiphertext         String    @map("secret_ciphertext")
  previousSecretCiphertext String?   @map("previous_secret_ciphertext")
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at")
  secretRotatedAt          DateTime? @map("secret_rotated_at")
  failingSince             DateTime? @map("failing_since")
  lastSuccessAt            DateTime? @map("last_success_at")
  lastFailureAt            DateTime? @map("last_failure_at")

  merchant    Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  application Application               @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  deliveries  MerchantWebhookDelivery[]

  @@index([applicationId, status])
  @@index([merchantId])
  @@map("merchant_webhook_endpoints")
}

/// AUTO-34: one delivery of one event to one endpoint (unique per endpoint and event id).
model MerchantWebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  endpointId     String    @map("endpoint_id") @db.Uuid
  merchantId     String    @map("merchant_id") @db.Uuid
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  /// The exact JSON text that is signed and sent (identical on every attempt).
  body           String
  /// PENDING | DELIVERED | PARKED (CHECK constraint).
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastStatusCode Int?      @map("last_status_code")
  lastLatencyMs  Int?      @map("last_latency_ms")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at")
  parkedAt       DateTime? @map("parked_at")
  parkReason     String?   @map("park_reason")

  endpoint MerchantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  merchant Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@index([merchantId, status, createdAt])
  @@map("merchant_webhook_deliveries")
}

