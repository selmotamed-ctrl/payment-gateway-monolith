}

model GlAccountShard {
  glAccountId    String             @map("gl_account_id") @db.Uuid
  shardId        Int                @map("shard_id") @db.SmallInt
  currentBalance Decimal            @default(0) @map("current_balance") @db.Decimal(18, 4)
  /// High-water of lines assigned to this shard (bumped with the balance, under the row lock).
  lineSeq        BigInt             @default(0) @map("line_seq")
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)
  glAccount      GlAccount          @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  checkpoint     GlShardCheckpoint?
  repairs        GlShardRepair[]

  @@id([glAccountId, shardId])
  @@map("gl_account_shards")
}

/// Append-only history of every shard repair (RECOMPUTE from the journal, or an approved REBASELINE).
model GlShardRepair {
  id                  String         @id @default(uuid(7)) @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  glAccountId         String         @map("gl_account_id") @db.Uuid
  shardId             Int            @map("shard_id") @db.SmallInt
  /// RECOMPUTE | REBASELINE
  kind                String
  /// AUTO | MANUAL | APPROVED
  mode                String
  planHash            String         @map("plan_hash")
  beforeBalance       Decimal        @map("before_balance") @db.Decimal(18, 4)
  afterBalance        Decimal        @map("after_balance") @db.Decimal(18, 4)
  delta               Decimal        @db.Decimal(18, 4)
  beforeLineSeq       BigInt         @map("before_line_seq")
  afterLineSeq        BigInt         @map("after_line_seq")
  beforeCheckpointSeq BigInt         @map("before_checkpoint_seq")
  afterCheckpointSeq  BigInt         @map("after_checkpoint_seq")
  baselineSeqAfter    BigInt         @map("baseline_seq_after")
  actorId             String?        @map("actor_id") @db.Uuid
  reason              String
  approvalRequestId   String?        @map("approval_request_id") @db.Uuid
  detailsJson         Json           @default("{}") @map("details_json")
  shard               GlAccountShard @relation(fields: [glAccountId, shardId], references: [glAccountId, shardId], onDelete: Restrict)

  @@index([glAccountId, shardId, createdAt])
  @@map("gl_shard_repairs")
}

/// The checkpoint of one shard: its balance as of line sequence `checkpointSeq`, proven against the journal
/// by the checkpointer (balance = previous checkpoint + the lines in the sequence range, gapless).
/// A shard without a row is at (0, seq 0).
model GlShardCheckpoint {
  glAccountId         String         @map("gl_account_id") @db.Uuid
  shardId             Int            @map("shard_id") @db.SmallInt
  checkpointBalance   Decimal        @default(0) @map("checkpoint_balance") @db.Decimal(18, 4)
  checkpointSeq       BigInt         @default(0) @map("checkpoint_seq")
  checkpointAt        DateTime?      @map("checkpoint_at") @db.Timestamptz(3)
  verifiedAt          DateTime?      @map("verified_at") @db.Timestamptz(3)
  /// OK | GAP | PARITY (CHECK constraint in the migration).
  status              String         @default("OK")
  failureKind         String?        @map("failure_kind")
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  lastFailureAt       DateTime?      @map("last_failure_at") @db.Timestamptz(3)
  /// Lines with a sequence at or below this are exempt from the gapless proof (set only by an approved re-baseline).
  baselineSeq         BigInt         @default(0) @map("baseline_seq")
  shard               GlAccountShard @relation(fields: [glAccountId, shardId], references: [glAccountId, shardId], onDelete: Restrict)

  @@id([glAccountId, shardId])
  @@map("gl_shard_checkpoints")
}

model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  topic         String    @db.VarChar(64)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  merchantId    String?   @map("merchant_id") @db.Uuid
  payloadJson   Json      @map("payload_json")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  /// Failed deliveries of this event (AUTO-02). It is parked after OUTBOX_MAX_ATTEMPTS.
  attempts      Int       @default(0)
  /// The last delivery error (bounded), kept for the operator.
  lastError     String?   @map("last_error") @db.VarChar(1000)
  /// Set when the event was parked: it keeps `processed_at` NULL but no longer blocks the relay.
  parkedAt      DateTime? @map("parked_at") @db.Timestamptz(3)

  @@index([id], map: "outbox_events_unprocessed_idx")
  @@index([createdAt], map: "outbox_events_created_idx")
  @@map("outbox_events")
}

model AuditOutbox {
  id                String    @id @default(uuid(7)) @db.Uuid
  actorId           String    @map("actor_id") @db.Uuid
  actorEmail        String?   @map("actor_email") @db.VarChar(191)
  role              String    @db.VarChar(64)
  action            String    @db.VarChar(96)
  entityType        String    @map("entity_type") @db.VarChar(64)
  entityId          String    @map("entity_id") @db.VarChar(64)
  merchantId        String?   @map("merchant_id") @db.Uuid
  approvalRequestId String?   @map("approval_request_id") @db.Uuid
  requestId         String?   @map("request_id") @db.VarChar(64)
  clientIp          String?   @map("client_ip") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.Text
  beforeJson        Json      @map("before_json")
  afterJson         Json      @map("after_json")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  shippedAt         DateTime? @map("shipped_at") @db.Timestamptz(3)
  /// Reservation of an in-flight shipper batch; NULL once shipped.
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(3)

  @@index([createdAt, id], map: "audit_outbox_unshipped_idx")
  @@map("audit_outbox")
}

model BackupCatalogRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  target         String    @db.VarChar(32)
  kind           String    @db.VarChar(16)
  engine         String    @db.VarChar(16)
  status         String    @db.VarChar(24)
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  durationMs     Int?      @map("duration_ms")
  sizeBytes      BigInt?   @map("size_bytes")
  startLsn       String?   @map("start_lsn") @db.VarChar(32)
  endLsn         String?   @map("end_lsn") @db.VarChar(32)
  storageTargets Json      @map("storage_targets")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([target, status])
  @@map("backup_catalog_runs")
}

model BackupRestoreDrill {
  id                String    @id @default(uuid(7)) @db.Uuid
  status            String    @db.VarChar(24)
  startedAt         DateTime  @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  durationMs        Int?      @map("duration_ms")
  targetTime        DateTime? @map("target_time") @db.Timestamptz(3)
  replayedLsn       String?   @map("replayed_lsn") @db.VarChar(32)
  doubleEntryDrift  Decimal   @default(0) @map("double_entry_drift") @db.Decimal(18, 4)
  balanceMismatches Int       @default(0) @map("balance_mismatches")
  auditBrokenLinks  Int       @default(0) @map("audit_broken_links")
  journalLineCount  BigInt    @default(0) @map("journal_line_count")
  checkpointsJson   Json      @map("checkpoints_json")
  errorMessage      String?   @map("error_message") @db.Text
  reportSignature   String?   @map("report_signature") @db.VarChar(128)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([status])
  @@map("backup_restore_drills")
}

model RmMerchantDailyStat {
  merchantId       String   @map("merchant_id") @db.Uuid
  day              DateTime @db.Date
  currency         String   @db.Char(3)
  attemptCount     Int      @default(0) @map("attempt_count")
  successCount     Int      @default(0) @map("success_count")
  failureCount     Int      @default(0) @map("failure_count")
  grossAmount      Decimal  @default(0) @map("gross_amount") @db.Decimal(18, 4)
  netAmount        Decimal  @default(0) @map("net_amount") @db.Decimal(18, 4)
  /// Gross / net of the attempts that SUCCEEDED on this day.
  successAmount    Decimal  @default(0) @map("success_amount") @db.Decimal(18, 4)
  successNetAmount Decimal  @default(0) @map("success_net_amount") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([merchantId, day, currency])
  @@index([day])
  @@map("rm_merchant_daily_stats")
}

model RmRouteDailyVolume {
  routeId      String   @map("route_id") @db.Uuid
  day          DateTime @db.Date
  currency     String   @db.Char(3)
  attemptCount Int      @default(0) @map("attempt_count")
  successCount Int      @default(0) @map("success_count")
  /// Volume of the attempts that SUCCEEDED on this day (cap semantics).
  volumeAmount Decimal  @default(0) @map("volume_amount") @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([routeId, day, currency])
  @@index([day])
  @@map("rm_route_daily_volumes")
}

// ---------------------------------------------------------------------------
// Dynamic Report Engine SDK (schema version 26)
// ---------------------------------------------------------------------------

enum ReportSpecStatus {
  DRAFT
  VERIFIED
  PUBLISHED
  ARCHIVED
}

enum ReportChromeType {
  HEADER
  FOOTER
}

enum ReportAudienceScope {
  BACKOFFICE_INTERNAL
  MERCHANT_FACING
  BOTH
}

enum ReportAuthorityMode {
  INFERRED_STRICT
  SECURITY_ADMIN_OVERRIDE
}

model ReportAssetBundle {
  id               String   @id @default(uuid(7)) @db.Uuid
  bundleSha256     String   @unique @map("bundle_sha256") @db.Char(64)
  storageKey       String   @map("storage_key") @db.Text
  totalBytes       Int      @map("total_bytes")
  fileCount        Int      @map("file_count")
  manifestJson     Json     @map("manifest_json")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chromeSpecs ReportChromeSpecRecord[]
  reportSpecs ReportDefinitionSpecRecord[]

  @@index([uploadedByUserId, createdAt(sort: Desc)], map: "report_asset_bundles_uploader_created_idx")
  @@map("report_asset_bundles")
}

model ReportChromeSpecRecord {
  id                String             @id @default(uuid(7)) @db.Uuid
  code              String             @db.VarChar(64)
  version           Int                @default(1)
  name              String             @db.VarChar(120)
  chromeType        ReportChromeType   @map("chrome_type")
  status            ReportSpecStatus   @default(DRAFT)
  isDefaultGlobal   Boolean            @default(false) @map("is_default_global")
  supportedLocales  String[]           @default([]) @map("supported_locales")
  specJson          Json               @map("spec_json")
  specSha256        String             @map("spec_sha256") @db.VarChar(64)
  assetBundleId     String?            @map("asset_bundle_id") @db.Uuid
  assetBundle       ReportAssetBundle? @relation(fields: [assetBundleId], references: [id], onDelete: SetNull)
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  publishedByUserId String?            @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([code, version], map: "report_chrome_specs_code_version_key")
  @@index([chromeType, status, isDefaultGlobal], map: "report_chrome_specs_type_status_default_idx")
  @@map("report_chrome_specs")
}

model ReportDefinitionSpecRecord {
  id                         String              @id @default(uuid(7)) @db.Uuid
  code                       String              @db.VarChar(64)
  version                    Int                 @default(1)
  category                   String              @db.VarChar(48)
  audienceScope              ReportAudienceScope @map("audience_scope")
  status                     ReportSpecStatus    @default(DRAFT)
  isLatestPublished          Boolean             @default(false) @map("is_latest_published")
  supportedLocales           String[]            @default([]) @map("supported_locales")
  defaultLocale              String              @default("en") @map("default_locale") @db.VarChar(16)
  specJson                   Json                @map("spec_json")
  specSha256                 String              @map("spec_sha256") @db.VarChar(64)
  verificationReportJson     Json                @map("verification_report_json")
  assetBundleId              String?             @map("asset_bundle_id") @db.Uuid
  assetBundle                ReportAssetBundle?  @relation(fields: [assetBundleId], references: [id], onDelete: SetNull)

  authorityMode              ReportAuthorityMode @default(INFERRED_STRICT) @map("authority_mode")
  inferredRoles              String[]            @default([]) @map("inferred_roles")
  inferredAuthorities        String[]            @default([]) @map("inferred_authorities")
  conflictStatus             String              @default("NONE") @map("conflict_status") @db.VarChar(48)
  requiresConfidentialAml    Boolean             @default(false) @map("requires_confidential_aml")
  overrideAllowedRoles       String[]            @default([]) @map("override_allowed_roles")
  overrideAllowedAuthorities String[]            @default([]) @map("override_allowed_authorities")
  overrideJustification      String?             @map("override_justification") @db.Text
  allowConfidentialAmlBypass Boolean             @default(false) @map("allow_confidential_aml_bypass")
  overriddenByUserId         String?             @map("overridden_by_user_id") @db.Uuid
  overriddenAt               DateTime?           @map("overridden_at") @db.Timestamptz(3)

  createdByUserId            String              @map("created_by_user_id") @db.Uuid
  publishedByUserId          String?             @map("published_by_user_id") @db.Uuid
  publishedAt                DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  executions ReportExecutionAuditRecord[]

  @@unique([code, version], map: "report_definition_specs_code_version_key")
  @@index([status, isLatestPublished, category], map: "report_definition_specs_published_cat_idx")
  @@index([audienceScope, status], map: "report_definition_specs_audience_status_idx")
  @@map("report_definition_specs")
}

model ReportExecutionAuditRecord {
  id                 String                     @id @default(uuid(7)) @db.Uuid
  reportSpecId       String                     @map("report_spec_id") @db.Uuid
  reportSpec         ReportDefinitionSpecRecord @relation(fields: [reportSpecId], references: [id], onDelete: Restrict)
  reportCode         String                     @map("report_code") @db.VarChar(64)
  reportVersion      Int                        @map("report_version")
  actorUserId        String                     @map("actor_user_id") @db.Uuid
  actorRole          String                     @map("actor_role") @db.VarChar(48)
  selectedLocale     String                     @map("selected_locale") @db.VarChar(16)
  scopedMerchantId   String?                    @map("scoped_merchant_id") @db.Uuid
  inputsRedactedJson Json                       @map("inputs_redacted_json")
  rowCountTotal      Int                        @map("row_count_total")
  durationMs         Int                        @map("duration_ms")
  servedByNode       String                     @map("served_by_node") @db.VarChar(64)
  verificationSha256 String                     @map("verification_sha256") @db.VarChar(64)
  renderTarget       String                     @default("CLIENT_PAGED_VECTOR") @map("render_target") @db.VarChar(32)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt(sort: Desc)], map: "report_execution_audit_actor_created_idx")
  @@index([scopedMerchantId, createdAt(sort: Desc)], map: "report_execution_audit_merchant_created_idx")
  @@index([reportSpecId, createdAt(sort: Desc)], map: "report_execution_audit_spec_created_idx")
  @@map("report_execution_audit")
}

// ---------------------------------------------------------------------------
// Merchant report authoring line (separate from the staff registry)
// ---------------------------------------------------------------------------

model MerchantReportSpecRecord {
  id                     String              @id @default(uuid(7)) @db.Uuid
  merchantId             String              @map("merchant_id") @db.Uuid
  code                   String              @db.VarChar(64)
  version                Int                 @default(1)
  category               String              @db.VarChar(48)
  status                 ReportSpecStatus    @default(DRAFT)
  isLatestPublished      Boolean             @default(false) @map("is_latest_published")
  supportedLocales       String[]            @default([]) @map("supported_locales")
  defaultLocale          String              @default("en") @map("default_locale") @db.VarChar(16)
  specJson               Json                @map("spec_json")
  specSha256             String              @map("spec_sha256") @db.VarChar(64)
  verificationReportJson Json?               @map("verification_report_json")
  assetBundleId          String?             @map("asset_bundle_id") @db.Uuid
  assetBundle            MerchantReportAssetBundle? @relation(fields: [assetBundleId], references: [id], onDelete: SetNull)
  createdByUserId        String              @map("created_by_user_id") @db.Uuid
  publishedByUserId      String?             @map("published_by_user_id") @db.Uuid
  publishedAt            DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  executions MerchantReportExecutionAudit[]

  @@unique([merchantId, code, version], map: "merchant_report_specs_merchant_code_version_key")
  @@index([merchantId, status, isLatestPublished], map: "merchant_report_specs_merchant_published_idx")
  @@map("merchant_report_specs")
}

model MerchantReportAssetBundle {
  id               String   @id @default(uuid(7)) @db.Uuid
  merchantId       String   @map("merchant_id") @db.Uuid
  bundleSha256     String   @map("bundle_sha256") @db.Char(64)
  storageKey       String   @map("storage_key") @db.Text
  totalBytes       Int      @map("total_bytes")
  fileCount        Int      @map("file_count")
  manifestJson     Json     @map("manifest_json")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  specRecords MerchantReportSpecRecord[]

  @@unique([merchantId, bundleSha256], map: "merchant_report_asset_bundles_merchant_sha_key")
  @@index([merchantId, createdAt(sort: Desc)], map: "merchant_report_asset_bundles_merchant_created_idx")
  @@map("merchant_report_asset_bundles")
}

model MerchantReportExecutionAudit {
  id                   String   @id @default(uuid(7)) @db.Uuid
  merchantSpecId       String?  @map("merchant_spec_id") @db.Uuid
  merchantSpec         MerchantReportSpecRecord? @relation(fields: [merchantSpecId], references: [id], onDelete: SetNull)
  merchantId           String   @map("merchant_id") @db.Uuid
  reportCode           String   @map("report_code") @db.VarChar(64)
  reportVersion        Int      @map("report_version")
  actorUserId          String   @map("actor_user_id") @db.Uuid
  actorRole            String   @map("actor_role") @db.VarChar(48)
