/**
 * The collected go-live evidence of a gateway version.
 * Design v5 §14: no `gateway_versions` row may become `LIVE` without passing
 * all twelve go-live gates. The evidence is produced by the sandbox suite
 * runner (`POST /gateway-versions/:vid/run-suite`) and read back by the
 * activation, so the gate decision is based on recorded facts and never on
 * hard-coded constants.
 */
model GatewayVersionEvidence {
  id               String   @id @default(uuid(7)) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  gatewayVersionId String   @unique @map("gateway_version_id") @db.Uuid
  evidenceJson     Json     @map("evidence_json")
  ranAt            DateTime @default(now()) @map("ran_at")

  gatewayVersion GatewayVersion @relation(fields: [gatewayVersionId], references: [id], onDelete: Cascade)

  @@map("gateway_version_evidence")
}

model GatewayEnvironment {
