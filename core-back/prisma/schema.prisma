/// Durable copy of the session revoke list (the Redis flag is the fast path and may be evicted or lost).
/// Rows are pruned once the revoked token would have expired anyway.
model SessionRevocation {
  jti       String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("session_revocations")
}

/// Exactly-once markers of the deadline worker (AUTO-04, AUTO-22): one row per (subject, stage), claimed in the same
/// transaction as the reminder, escalation or deadline outcome it guards.
model DeadlineStage {
  subjectType String   @map("subject_type") @db.VarChar(32)
  subjectId   String   @map("subject_id") @db.VarChar(64)
  stage       String   @db.VarChar(48)
  firedAt     DateTime @default(now()) @map("fired_at") @db.Timestamptz(3)
  detailJson  Json?    @map("detail_json")

  @@id([subjectType, subjectId, stage])
  @@index([firedAt])
  @@map("deadline_stages")
}

/// Keyset cursors that singleton workers persist between ticks (AUTO-25), so a bounded pass walks the whole table and
/// resumes after a restart or a leader change.
model WorkerCursor {
  name        String   @id @db.VarChar(96)
  cursorValue String?  @map("cursor_value")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("worker_cursors")
}

