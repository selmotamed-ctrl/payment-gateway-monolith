  "attempt-transitions": {
    "initial": "CREATED",
    "states": [
      {
        "id": "CREATED",
        "slot": "reserved",
        "money": "none",
        "human": "Nothing to do. Seconds only; escalate if it stays."
      },
      {
        "id": "INITIATING",
        "slot": "reserved",
        "money": "none",
        "human": "Nothing to do."
      },
      {
        "id": "AWAITING_CUSTOMER",
        "slot": "reserved",
        "money": "none",
        "human": "Nothing to do. Never nudge the customer to pay again."
      },
      {
        "id": "AUTHORIZING",
        "slot": "reserved",
        "money": "none",
        "human": "Nothing to do. It will become UNKNOWN by itself if the partner is silent."
      },
      {
        "id": "VERIFYING",
        "slot": "reserved",
        "money": "none",
        "human": "Nothing to do unless it stays long."
      },
      {
        "id": "UNKNOWN",
        "slot": "reserved",
        "money": "none",
        "human": "We do not know. Use Inquire, then follow the UNKNOWN article. Never guess."
      },
      {
        "id": "SUCCEEDED",
        "slot": "consumed",
        "money": "posted",
        "human": "Nothing to do. Verified and posted together."
      },
      {
