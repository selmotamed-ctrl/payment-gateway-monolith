  "examples": {
    "descriptor": "{\n  \"spec_kind\": \"REPORT_DESCRIPTOR\",\n  \"spec_version\": \"1.0\",\n  \"report\": {\n    \"code\": \"merchant-settlement-summary\",\n    \"version\": 1,\n    \"category\": \"MERCHANT_SETTLEMENT\",\n    \"audience_scope\": \"BOTH\",\n    \"merchant_scope_input_key\": \"merchantId\",\n    \"classification\": \"MERCHANT_CONFIDENTIAL\"\n  },\n  \"page_layout\": {\n    \"paper_size\": \"A4\",\n    \"orientation\": \"PORTRAIT\",\n    \"header_mode\": \"GLOBAL_DEFAULT\",\n    \"footer_mode\": \"GLOBAL_DEFAULT\"\n  },\n  \"required_assets\": [],\n  \"suggested_access\": {\n    \"roles\": [\n      \"OPERATOR\",\n      \"FINANCE\",\n      \"SUPPORT\"\n    ],\n    \"authorities\": [\n      \"merchant:read\"\n    ]\n  },\n  \"i18n\": {\n    \"default_locale\": \"en\",\n    \"prompt_user_when_multi_locale\": true,\n    \"locales\": {\n      \"en\": {\n        \"report.title\": \"Merchant Settlement Summary\",\n        \"input.merchant\": \"Target Merchant\",\n        \"input.period\": \"Statement Period\",\n        \"kpi.title\": \"Settlement Summary\",\n        \"kpi.total\": \"Total Movement\",\n        \"table.title\": \"Daily Turnover\",\n        \"table.day\": \"Day\",\n        \"table.amount\": \"Amount\"\n      },\n      \"ar\": {\n        \"report.title\": \"ملخص تسويات التاجر\",\n        \"input.merchant\": \"التاجر المستهدف\",\n        \"input.period\": \"فترة الكشف\",\n        \"kpi.title\": \"ملخص التسوية\",\n        \"kpi.total\": \"إجمالي الحركة\",\n        \"table.title\": \"الحركة اليومية\",\n        \"table.day\": \"اليوم\",\n        \"table.amount\": \"المبلغ\"\n      }\n    }\n  },\n  \"inputs\": [\n    {\n      \"key\": \"merchantId\",\n      \"label_i18n_key\": \"input.merchant\",\n      \"type\": \"entity_autocomplete\",\n      \"required\": true,\n      \"autocomplete\": {\n        \"source\": \"merchants\"\n      }\n    },\n    {\n      \"key\": \"periodRange\",\n      \"label_i18n_key\": \"input.period\",\n      \"type\": \"daterange\",\n      \"required\": true,\n      \"validation\": {\n        \"max_range_days\": 180\n      },\n      \"default_value\": {\n        \"preset\": \"CURRENT_MONTH\"\n      }\n    }\n  ],\n  \"datasets\": [\n    {\n      \"dataset_id\": \"totals\",\n      \"description\": \"Merchant payment totals by currency for the selected period\",\n      \"from_model\": \"payment_attempts\",\n      \"from_alias\": \"pa\",\n      \"select\": [\n        {\n          \"alias\": \"currency\",\n          \"column\": \"currency\"\n        },\n        {\n          \"alias\": \"total\",\n          \"column\": \"total_charged_amount_minor\",\n          \"aggregate\": \"SUM\",\n          \"format_hint\": \"CURRENCY_MINOR\"\n        }\n      ],\n      \"where\": {\n        \"kind\": \"GROUP\",\n        \"logic\": \"AND\",\n        \"conditions\": [\n          {\n            \"kind\": \"PREDICATE\",\n            \"column\": \"merchant_id\",\n            \"op\": \"eq\",\n            \"binding\": {\n              \"source\": \"INPUT\",\n              \"input_key\": \"merchantId\"\n            }\n          },\n          {\n            \"kind\": \"PREDICATE\",\n            \"column\": \"created_at\",\n            \"op\": \"between\",\n            \"binding\": {\n              \"source\": \"INPUT\",\n              \"input_key\": \"periodRange\",\n              \"range_bound\": \"BOTH\"\n            }\n          }\n        ]\n      },\n      \"group_by\": [\n        \"currency\"\n      ],\n      \"limit\": 10\n    }\n  ],\n  \"transforms\": [],\n  \"sections\": [\n    {\n      \"section_type\": \"KPI_GRID\",\n      \"section_id\": \"kpis\",\n      \"title_i18n_key\": \"kpi.title\",\n      \"columns\": 2,\n      \"cards\": [\n        {\n          \"label_i18n_key\": \"kpi.total\",\n          \"dataset_id\": \"totals\",\n          \"value_field\": \"total\",\n          \"format_hint\": \"CURRENCY_MINOR\",\n          \"tone\": \"PRIMARY\"\n        }\n      ]\n    }\n  ]\n}",
    "merchantDescriptor": "{\n  \"spec_kind\": \"REPORT_DESCRIPTOR\",\n  \"spec_version\": \"1.0\",\n  \"report\": {\n    \"code\": \"merchant-settlement-summary\",\n    \"version\": 1,\n    \"category\": \"MERCHANT_SETTLEMENT\",\n    \"audience_scope\": \"BOTH\",\n    \"merchant_scope_input_key\": \"merchantId\",\n    \"classification\": \"MERCHANT_CONFIDENTIAL\"\n  },\n  \"page_layout\": {\n    \"paper_size\": \"A4\",\n    \"orientation\": \"PORTRAIT\",\n    \"header_mode\": \"GLOBAL_DEFAULT\",\n    \"footer_mode\": \"GLOBAL_DEFAULT\"\n  },\n  \"required_assets\": [],\n  \"i18n\": {\n    \"default_locale\": \"en\",\n    \"prompt_user_when_multi_locale\": true,\n    \"locales\": {\n      \"en\": {\n        \"report.title\": \"Merchant Settlement Summary\",\n        \"input.merchant\": \"Target Merchant\",\n        \"input.period\": \"Statement Period\",\n        \"kpi.title\": \"Settlement Summary\",\n        \"kpi.total\": \"Total Movement\",\n        \"table.title\": \"Daily Turnover\",\n        \"table.day\": \"Day\",\n        \"table.amount\": \"Amount\"\n      },\n      \"ar\": {\n        \"report.title\": \"ملخص تسويات التاجر\",\n        \"input.merchant\": \"التاجر المستهدف\",\n        \"input.period\": \"فترة الكشف\",\n        \"kpi.title\": \"ملخص التسوية\",\n        \"kpi.total\": \"إجمالي الحركة\",\n        \"table.title\": \"الحركة اليومية\",\n        \"table.day\": \"اليوم\",\n        \"table.amount\": \"المبلغ\"\n      }\n    }\n  },\n  \"inputs\": [\n    {\n      \"key\": \"merchantId\",\n      \"label_i18n_key\": \"input.merchant\",\n      \"type\": \"entity_autocomplete\",\n      \"required\": true,\n      \"autocomplete\": {\n        \"source\": \"merchants\"\n      }\n    },\n    {\n      \"key\": \"periodRange\",\n      \"label_i18n_key\": \"input.period\",\n      \"type\": \"daterange\",\n      \"required\": true,\n      \"validation\": {\n        \"max_range_days\": 90\n      },\n      \"default_value\": {\n        \"preset\": \"CURRENT_MONTH\"\n      }\n    }\n  ],\n  \"datasets\": [\n    {\n      \"dataset_id\": \"totals\",\n      \"description\": \"Merchant payment totals by currency for the selected period\",\n      \"from_model\": \"payment_attempts\",\n      \"from_alias\": \"pa\",\n      \"select\": [\n        {\n          \"alias\": \"currency\",\n          \"column\": \"currency\"\n        },\n        {\n          \"alias\": \"total\",\n          \"column\": \"total_charged_amount_minor\",\n          \"aggregate\": \"SUM\",\n          \"format_hint\": \"CURRENCY_MINOR\"\n        }\n      ],\n      \"where\": {\n        \"kind\": \"GROUP\",\n        \"logic\": \"AND\",\n        \"conditions\": [\n          {\n            \"kind\": \"PREDICATE\",\n            \"column\": \"merchant_id\",\n            \"op\": \"eq\",\n            \"binding\": {\n              \"source\": \"INPUT\",\n              \"input_key\": \"merchantId\"\n            }\n          },\n          {\n            \"kind\": \"PREDICATE\",\n            \"column\": \"created_at\",\n            \"op\": \"between\",\n            \"binding\": {\n              \"source\": \"INPUT\",\n              \"input_key\": \"periodRange\",\n              \"range_bound\": \"BOTH\"\n            }\n          }\n        ]\n      },\n      \"group_by\": [\n        \"currency\"\n      ],\n      \"limit\": 10\n    }\n  ],\n  \"transforms\": [],\n  \"sections\": [\n    {\n      \"section_type\": \"KPI_GRID\",\n      \"section_id\": \"kpis\",\n      \"title_i18n_key\": \"kpi.title\",\n      \"columns\": 2,\n      \"cards\": [\n        {\n          \"label_i18n_key\": \"kpi.total\",\n          \"dataset_id\": \"totals\",\n          \"value_field\": \"total\",\n          \"format_hint\": \"CURRENCY_MINOR\",\n          \"tone\": \"PRIMARY\"\n        }\n      ]\n    }\n  ]\n}",
    "topTen": "{\n  \"spec_kind\": \"REPORT_DESCRIPTOR\",\n  \"spec_version\": \"1.0\",\n  \"report\": {\n    \"code\": \"top-ten-merchants-by-volume\",\n    \"version\": 1,\n    \"category\": \"MERCHANT_SETTLEMENT\",\n    \"audience_scope\": \"BACKOFFICE_INTERNAL\",\n    \"classification\": \"INTERNAL\"\n  },\n  \"page_layout\": {\n    \"paper_size\": \"A4\",\n    \"orientation\": \"PORTRAIT\",\n    \"header_mode\": \"GLOBAL_DEFAULT\",\n    \"footer_mode\": \"GLOBAL_DEFAULT\"\n  },\n  \"required_assets\": [],\n  \"suggested_access\": {\n    \"roles\": [\n      \"OPERATOR\",\n      \"FINANCE\"\n    ],\n    \"authorities\": [\n      \"merchant:read\"\n    ]\n  },\n  \"i18n\": {\n    \"default_locale\": \"en\",\n    \"prompt_user_when_multi_locale\": true,\n    \"locales\": {\n      \"en\": {\n        \"report.title\": \"Top 10 Merchants by Volume\",\n        \"input.period\": \"Period\",\n        \"table.title\": \"Top Merchants\",\n        \"table.merchant\": \"Merchant\",\n        \"table.attempts\": \"Attempts\",\n        \"table.volume\": \"Volume\"\n      },\n      \"ar\": {\n        \"report.title\": \"أفضل 10 تجار حسب الحجم\",\n        \"input.period\": \"الفترة\",\n        \"table.title\": \"أفضل التجار\",\n        \"table.merchant\": \"التاجر\",\n        \"table.attempts\": \"المحاولات\",\n        \"table.volume\": \"الحجم\"\n      }\n    }\n  },\n  \"inputs\": [\n    {\n      \"key\": \"periodRange\",\n      \"label_i18n_key\": \"input.period\",\n      \"type\": \"daterange\",\n      \"required\": true,\n      \"validation\": {\n        \"max_range_days\": 180\n      },\n      \"default_value\": {\n        \"preset\": \"LAST_30_DAYS\"\n      }\n    }\n  ],\n  \"datasets\": [\n    {\n      \"dataset_id\": \"top_merchants\",\n      \"description\": \"Top merchants by settled volume\",\n      \"from_model\": \"payment_attempts\",\n      \"from_alias\": \"pa\",\n      \"joins\": [\n        {\n          \"join_type\": \"LEFT\",\n          \"relation_name\": \"merchant\",\n          \"target_model\": \"merchants\",\n          \"alias\": \"m\"\n        }\n      ],\n      \"select\": [\n        {\n          \"alias\": \"merchant_id\",\n          \"column\": \"id\",\n          \"table_alias\": \"m\"\n        },\n        {\n          \"alias\": \"merchant_name\",\n          \"column\": \"trade_name\",\n          \"table_alias\": \"m\"\n        },\n        {\n          \"alias\": \"attempts\",\n          \"column\": \"id\",\n          \"aggregate\": \"COUNT\",\n          \"format_hint\": \"INTEGER\"\n        },\n        {\n          \"alias\": \"volume_minor\",\n          \"column\": \"total_charged_amount_minor\",\n          \"aggregate\": \"SUM\",\n          \"format_hint\": \"CURRENCY_MINOR\"\n        }\n      ],\n      \"where\": {\n        \"kind\": \"PREDICATE\",\n        \"column\": \"created_at\",\n        \"op\": \"between\",\n        \"binding\": {\n          \"source\": \"INPUT\",\n          \"input_key\": \"periodRange\",\n          \"range_bound\": \"BOTH\"\n        }\n      },\n      \"group_by\": [\n        \"merchant_id\",\n        \"merchant_name\"\n      ],\n      \"order_by\": [\n        {\n          \"field\": \"volume_minor\",\n          \"direction\": \"DESC\"\n        }\n      ],\n      \"limit\": 10\n    }\n  ],\n  \"transforms\": [],\n  \"sections\": [\n    {\n      \"section_type\": \"DATA_TABLE\",\n      \"section_id\": \"top_table\",\n      \"title_i18n_key\": \"table.title\",\n      \"dataset_id\": \"top_merchants\",\n      \"columns\": [\n        {\n          \"field\": \"merchant_name\",\n          \"header_i18n_key\": \"table.merchant\",\n          \"width_percent\": 50\n        },\n        {\n          \"field\": \"attempts\",\n          \"header_i18n_key\": \"table.attempts\",\n          \"align\": \"END\",\n          \"width_percent\": 20,\n          \"format_hint\": \"INTEGER\"\n        },\n        {\n          \"field\": \"volume_minor\",\n          \"header_i18n_key\": \"table.volume\",\n          \"align\": \"END\",\n          \"width_percent\": 30,\n          \"format_hint\": \"CURRENCY_MINOR\"\n        }\n      ]\n    }\n  ]\n}",
    "chrome": "{\n  \"spec_kind\": \"REPORT_CHROME\",\n  \"spec_version\": \"1.0\",\n  \"chrome\": {\n    \"code\": \"institutional-header-v1\",\n    \"name\": \"Institutional Header\",\n    \"chrome_type\": \"HEADER\",\n    \"description\": \"Bilingual institutional header\",\n    \"height_mm\": 22,\n    \"show_on_first_page\": true,\n    \"border_style\": \"THIN_RULE\"\n  },\n  \"required_assets\": [\n    {\n      \"asset_key\": \"institution_logo\",\n      \"file_name\": \"institution-crest.svg\",\n      \"mime_type\": \"image/svg+xml\",\n      \"alt_i18n_key\": \"chrome.logo_alt\",\n      \"max_width_mm\": 38,\n      \"max_height_mm\": 16\n    }\n  ],\n  \"i18n\": {\n    \"default_locale\": \"en\",\n    \"locales\": {\n      \"en\": {\n        \"chrome.logo_alt\": \"Institution official crest\",\n        \"chrome.division\": \"Financial Operations\",\n        \"chrome.page\": \"Page\",\n        \"chrome.of\": \"of\"\n      },\n      \"ar\": {\n        \"chrome.logo_alt\": \"الشعار الرسمي للمؤسسة\",\n        \"chrome.division\": \"العمليات المالية\",\n        \"chrome.page\": \"صفحة\",\n        \"chrome.of\": \"من\"\n      }\n    }\n  },\n  \"template\": {\n    \"html\": \"<div style=\\\"display:flex;justify-content:space-between;align-items:center\\\"><div><img src=\\\"asset://institution_logo\\\" alt=\\\"{{$t.chrome.logo_alt}}\\\" style=\\\"height:14mm\\\" /><strong>{{institutionName}}</strong> — {{$t.chrome.division}}</div><div>{{reportTitle}} ({{reportCode}} v{{reportVersion}}) — {{$t.chrome.page}} <span class=\\\"report-page-number\\\"></span> {{$t.chrome.of}} <span class=\\\"report-total-pages\\\"></span></div></div>\",\n    \"scoped_css\": \"\",\n    \"used_variables\": [\n      \"institutionName\",\n      \"reportTitle\",\n      \"reportCode\",\n      \"reportVersion\",\n      \"pageNumber\",\n      \"totalPages\"\n    ]\n  }\n}"
