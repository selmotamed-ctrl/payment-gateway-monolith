# ==============================================================================
# pg-backup-daemon environment (validated by src/config.ts)
# ==============================================================================
# In a deployed installation this file is GENERATED AUTOMATICALLY by
# deploy/provisioners/backupEngineProvisioner.ts from deploy/deploy.env.
# Do not copy it manually in production; it is kept as the local/troubleshooting
# reference for `bun run start`. Every key below is read by the daemon.
# ==============================================================================

# --- Engine and encryption ----------------------------------------------------
BACKUP_ENGINE_MODE="wal-g"              # "wal-g" | "barman"
BACKUP_COMPRESSION="zstd"               # "zstd" | "lz4" | "lzma" | "brotli" | "none"
# Exactly 64 hex characters for a 32-byte key; must be even-length and >= 32 chars.
BACKUP_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BACKUP_ALLOW_INSECURE_HTTP="false"      # development only; keep false for mTLS
BACKUP_COMMAND_TIMEOUT_MS="1800000"

# --- Primary S3/MinIO/R2 target and optional secondary vault ------------------
BACKUP_PRIMARY_S3_ENDPOINT="https://s3.example.invalid"
BACKUP_PRIMARY_S3_BUCKET="s3://payment-gateway-backups/prod"
# Optional per-target prefixes; default <bucket>/postgres_core and <bucket>/audit_db.
# BACKUP_CORE_S3_PREFIX="s3://payment-gateway-backups/prod/postgres_core"
# BACKUP_AUDIT_S3_PREFIX="s3://payment-gateway-backups/prod/audit_db"
BACKUP_PRIMARY_S3_ACCESS_KEY="change-me-s3-access-key"
BACKUP_PRIMARY_S3_SECRET_KEY="change-me-s3-secret-key"
# Both S3 keys must be set together, or both left empty.
BACKUP_SECONDARY_SSH_TARGET="backup-vault@198.51.100.99:/mnt/offsite-vault/pg"

# --- Schedule, retention and alerts -------------------------------------------
BACKUP_FULL_CRON="0 2 * * 0"            # Sunday 02:00
BACKUP_DELTA_CRON="0 2 * * 1-6"         # Monday-Saturday 02:00
BACKUP_DRILL_CRON="0 4 * * 0"           # Sunday 04:00 restore + invariant drill
BACKUP_RETENTION_FULL_COUNT="8"
BACKUP_RETENTION_WAL_DAYS="14"
BACKUP_ALERT_LAG_SECONDS="300"
SCHEDULER_ENABLED="true"
SCHEDULER_TICK_MS="30000"

# --- Listener and mTLS --------------------------------------------------------
BACKUP_DAEMON_PORT="4090"
BACKUP_DAEMON_BIND_HOST="0.0.0.0"
# Supply the certificate, key and CA together for mTLS. Without a certificate
# pair the daemon refuses to start unless BACKUP_ALLOW_INSECURE_HTTP="true"
# (development only).
BACKUP_DAEMON_CERT_PATH="/var/lib/pg-backup/shared/certs/backup-daemon.crt"
BACKUP_DAEMON_KEY_PATH="/var/lib/pg-backup/shared/certs/backup-daemon.key"
BACKUP_DAEMON_CA_CERT_PATH="/var/lib/pg-backup/shared/certs/internal-ca.crt"

# --- PostgreSQL 18 connection and binaries ------------------------------------
PG_PRIMARY_HOST="10.10.10.10"
PG_PRIMARY_PORT="5432"
PG_PRIMARY_USER="postgres"
PG_PRIMARY_PASSWORD="change-me-backup-role-password"
PG_PRIMARY_DB_NAME="payment_gateway_prod"
PG_AUDIT_DB_NAME="pg_audit_db"
PG_REPLICA_NODES="pg-rep-1,pg-rep-2"
PG_DATA_DIR="/var/lib/postgresql/18/main"
# PG_AUDIT_DATA_DIR="/var/lib/postgresql/18/audit"
PG_BIN_DIR="/usr/lib/postgresql/18/bin"
WALG_BIN="wal-g"
BARMAN_BIN="barman"
BARMAN_CLOUD_BIN="barman-cloud-backup"
# BARMAN_SERVER="payment-gateway-prod"
# BARMAN_AUDIT_SERVER="payment-gateway-audit"  # defaults to PG_AUDIT_DB_NAME

# --- Catalog and scratch restore drill ----------------------------------------
BACKUP_CATALOG_PATH="/var/lib/pg-backup/catalog.json"
BACKUP_SCRATCH_DIR="/var/lib/pg-backup/scratch"
BACKUP_SCRATCH_PORT="55432"
# BACKUP_SCRATCH_AUDIT_DIR="/var/lib/pg-backup/scratch/audit"
BACKUP_SCRATCH_AUDIT_PORT="55433"

# --- Redis snapshot support (optional) ----------------------------------------
# Redis snapshots are dumped with redis-cli and uploaded with rclone to
# <BACKUP_CORE_S3_PREFIX>/redis/dump.rdb. rclone must be installed when REDIS_URL is set.
# REDIS_URL="redis://:change-me@10.10.11.10:6379/0"
REDIS_CLI_BIN="redis-cli"

# mTLS authorization: only client certificates whose subject CN (or DNS SAN) is listed here may call the API (403 otherwise).
BACKUP_ALLOWED_CLIENT_CNS="backup-client"
# Optional: restore_command sources this 0640 env file instead of embedding S3/encryption secrets in postgresql.auto.conf.
# WALG_ENV_FILE="/etc/pg-backup/wal-g.env"
# Off-site copy never deletes by default (rclone copy / rsync -a). Set true to mirror deletions (rclone sync / rsync --delete).
BACKUP_SECONDARY_MIRROR_DELETE="false"
