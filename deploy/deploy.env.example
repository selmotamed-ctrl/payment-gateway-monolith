# ==============================================================================
# MULTI-RAIL PAYMENT GATEWAY — MULTI-HOST DEPLOYMENT CONFIGURATION (deploy.env)
# ==============================================================================
# Copy this file to deploy/deploy.env (chmod 600) and fill it in. It is
# gitignored. Supports 1 to 5 servers: give two roles the same SSH_HOST,
# SSH_USER, SSH_KEY_PATH and SUDO_PASSWORD and the orchestrator merges them
# into one host (OS bootstrap once, both PM2 apps, both Nginx vhosts, unioned
# UFW rules).
#
# Validate without touching any server:
#   ./deploy/deploy.sh --dry-run
# ==============================================================================

# --- 0. GLOBAL DEPLOYMENT OPTIONS ---------------------------------------------
DEPLOY_MODE="auto"                  # "auto" | "fresh" | "update"
KEEP_RELEASES="5"                   # atomic releases kept per host for rollback
ROTATE_MTLS_CERTS="false"           # "true" regenerates the CA and all leaf certs
MTLS_VALIDITY_DAYS="825"            # validity of the generated mTLS certificates
LAN_ALLOWED_CIDRS="10.0.0.0/8,192.168.0.0/16" # allowed LAN subnets for admin

# --- 1. DATABASE SERVER (DB_HOST) ---------------------------------------------
# Set DB_MANAGE_VIA_SSH="true" to let the script create the database and the
# application user ON the database host through its own sudo access, and lock
# the firewall to CORE_PRIVATE_IP only.
DB_MANAGE_VIA_SSH="true"
DB_SSH_HOST="10.10.0.10"
DB_SSH_PORT="22"
DB_SSH_USER="ubuntu"
DB_SSH_KEY_PATH="~/.ssh/id_ed25519_pg_db"
DB_SUDO_PASSWORD="change-me-db-sudo"
DB_PRIVATE_IP="10.10.0.10"
DB_ENGINE="mysql"                   # "mysql" | "postgresql"
DB_PORT="3306"
DB_NAME="payment_gateway_prod"
DB_USER="pg_core_user"
DB_PASSWORD="change-me-strong-db-password"
# The application connection string. It must match DB_ENGINE and DB_PRIVATE_IP.
DATABASE_URL="mysql://pg_core_user:change-me-strong-db-password@10.10.0.10:3306/payment_gateway_prod"

# --- 2. CORE-BACK SERVER (CORE_HOST — private LAN only, sole DB owner) ---------
CORE_SSH_HOST="10.10.0.20"
CORE_SSH_PORT="22"
CORE_SSH_USER="ubuntu"
CORE_SSH_KEY_PATH="~/.ssh/id_ed25519_pg_core"
CORE_SUDO_PASSWORD="change-me-core-sudo"
CORE_PRIVATE_IP="10.10.0.20"        # bound by the mTLS server, in the cert SAN
CORE_PORT="4000"
CORE_REMOTE_DIR="/var/www/pg-core"
RUN_PRISMA_SEED="false"             # "true" on the first deploy only

# --- 3. ADMIN SERVER (ADMIN_HOST — private LAN only, non-forwarded port) ------
ADMIN_SSH_HOST="10.10.0.30"
ADMIN_SSH_PORT="22"
ADMIN_SSH_USER="ubuntu"
ADMIN_SSH_KEY_PATH="~/.ssh/id_ed25519_pg_admin"
ADMIN_SUDO_PASSWORD="change-me-admin-sudo"
ADMIN_PRIVATE_IP="10.10.0.30"
ADMIN_BACK_PORT="4101"
ADMIN_NGINX_LAN_PORT="8443"         # HTTPS on the LAN only, never router-forwarded
ADMIN_DOMAIN="admin.internal"
ADMIN_REMOTE_DIR="/var/www/pg-admin"

# --- 4. MERCHANT SERVER (MERCHANT_HOST — public SSL 80/443) -------------------
MERCHANT_SSH_HOST="203.0.113.10"
MERCHANT_SSH_PORT="22"
MERCHANT_SSH_USER="ubuntu"
MERCHANT_SSH_KEY_PATH="~/.ssh/id_ed25519_pg_merchant"
MERCHANT_SUDO_PASSWORD="change-me-merchant-sudo"
MERCHANT_PRIVATE_IP="10.10.0.40"
MERCHANT_BACK_PORT="4102"
MERCHANT_DOMAIN="merchant.yourdomain.ly"
MERCHANT_SSL_MODE="certbot"         # "certbot" | "custom" | "self_signed"
MERCHANT_SSL_CERT_PATH="/etc/letsencrypt/live/merchant.yourdomain.ly/fullchain.pem"
MERCHANT_SSL_KEY_PATH="/etc/letsencrypt/live/merchant.yourdomain.ly/privkey.pem"
MERCHANT_REMOTE_DIR="/var/www/pg-merchant"

# --- 5. CHECKOUT SERVER (CHECKOUT_HOST — public SSL 80/443) -------------------
CHECKOUT_SSH_HOST="203.0.113.20"
CHECKOUT_SSH_PORT="22"
CHECKOUT_SSH_USER="ubuntu"
CHECKOUT_SSH_KEY_PATH="~/.ssh/id_ed25519_pg_checkout"
CHECKOUT_SUDO_PASSWORD="change-me-checkout-sudo"
CHECKOUT_PRIVATE_IP="10.10.0.50"
CHECKOUT_BACK_PORT="4103"
CHECKOUT_DOMAIN="pay.yourdomain.ly"
CHECKOUT_SSL_MODE="certbot"
CHECKOUT_SSL_CERT_PATH="/etc/letsencrypt/live/pay.yourdomain.ly/fullchain.pem"
CHECKOUT_SSL_KEY_PATH="/etc/letsencrypt/live/pay.yourdomain.ly/privkey.pem"
CHECKOUT_REMOTE_DIR="/var/www/pg-checkout"

# --- 6. CORE-ONLY SECRETS (delivered ONLY to CORE_HOST) -----------------------
KMS_MASTER_KEY="change-me-at-least-32-characters-long-secret"
BASE_CURRENCY="LYD"
GATEWAY_TIMEZONE="Africa/Tripoli"
REDIS_URL=""                        # optional, for a multi-node InvalidationBus

# ==============================================================================
# TOPOLOGY EXAMPLES
# ==============================================================================
# A) 5 separate servers: every *_SSH_HOST above is a distinct IP.
# B) 2 servers (internal + public edge):
#      ADMIN_SSH_HOST = CORE_SSH_HOST    (same internal box)
#      CHECKOUT_SSH_HOST = MERCHANT_SSH_HOST (same public box)
#      use the same SSH_USER / SSH_KEY_PATH / SUDO_PASSWORD for each pair.
# C) 1 all-in-one staging box:
#      set every *_SSH_HOST to the same IP and the same SSH key; the ports stay
#      distinct (4000, 4101, 4102, 4103, 8443, 443) and mTLS is still enforced.
