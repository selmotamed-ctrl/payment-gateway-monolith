# Optional content-only update endpoint. Leave empty for a fully offline build.
# The manifest must be signed by the key pinned in public/content/public-key.txt.
VITE_COMPANION_UPDATE_URL=

# Optional override for the pinned public key (normally read from
# public/content/public-key.txt). Use this in CI if the key is a secret.
# VITE_COMPANION_CONTENT_PUBLIC_KEY=
